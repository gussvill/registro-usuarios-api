      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "users"
          ]
        },
        "description": "Los teléfonos son opcionales: sin la clave phones se registra el usuario y la respuesta lleva phones como arreglo vacío.",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Juan Rodriguez\",\"email\":\"{{noPhonesEmail}}\",\"password\":\"hunter2\"}",
