              "",
              "function validarUsuarioCreado(body, correoEsperado, telefonosEsperados) {",
              "  const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;",
              "  pm.test('id es un UUID', function () {",
              "    pm.expect(body.id).to.match(uuid);",
              "  });",
              "  pm.test('created, modified y last_login existen y son iguales', function () {",
