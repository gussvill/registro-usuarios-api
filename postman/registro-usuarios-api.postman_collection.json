              "  pm.test('la respuesta no contiene la clave password', function () {",
              "    pm.expect(body).to.not.have.property('password');",
              "    pm.expect(JSON.stringify(body)).to.not.include('hunter2');",
              "  });",
              "  pm.test('la respuesta tiene exactamente las nueve claves documentadas', function () {",
              "    pm.expect(Object.keys(body).sort()).to.eql(",
