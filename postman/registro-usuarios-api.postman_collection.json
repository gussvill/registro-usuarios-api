    {
      "name": "09 Correo en dominio.cl con parte local única responde 201",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const marca = Date.now() + '-' + Math.floor(Math.random() * 1000000);",
              "pm.collectionVariables.set('dominioEmail', 'aaaaaaa-' + marca + '@dominio.cl');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Content-Type es application/json', function () {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.match(/^application\\/json/);",
              "});",
              "",
              "function validarUsuarioCreado(body, correoEsperado, telefonosEsperados) {",
              "  const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;",
              "  pm.test('id es un UUID', function () {",
              "    pm.expect(body.id).to.match(uuid);",
              "  });",
              "  pm.test('created, modified y last_login existen y son iguales', function () {",
              "    pm.expect(body.created).to.be.a('string').and.not.empty;",
              "    pm.expect(body.modified).to.eql(body.created);",
              "    pm.expect(body.last_login).to.eql(body.created);",
              "  });",
              "  pm.test('token tiene tres partes separadas por punto', function () {",
              "    pm.expect(body.token).to.be.a('string');",
              "    pm.expect(body.token.split('.')).to.have.lengthOf(3);",
              "    body.token.split('.').forEach(function (parte) { pm.expect(parte).to.match(/^[A-Za-z0-9_-]+$/); });",
              "  });",
              "  pm.test('isactive es true', function () {",
              "    pm.expect(body.isactive).to.eql(true);",
              "  });",
              "  pm.test('nombre y correo se devuelven (correo en minúsculas)', function () {",
              "    pm.expect(body.name).to.eql('Juan Rodriguez');",
              "    pm.expect(body.email).to.eql(correoEsperado.toLowerCase());",
              "  });",
              "  pm.test('los teléfonos se devuelven con contrycode', function () {",
              "    pm.expect(body.phones).to.eql(telefonosEsperados);",
              "  });",
              "  pm.test('la respuesta no contiene la clave password', function () {",
              "    pm.expect(body).to.not.have.property('password');",
              "    pm.expect(JSON.stringify(body)).to.not.include('hunter2');",
              "  });",
              "  pm.test('la respuesta tiene exactamente las nueve claves documentadas', function () {",
              "    pm.expect(Object.keys(body).sort()).to.eql(",
              "      ['created', 'email', 'id', 'isactive', 'last_login', 'modified', 'name', 'phones', 'token'].sort());",
              "  });",
              "}",
              "",
              "validarUsuarioCreado(pm.response.json(), pm.collectionVariables.get('dominioEmail'), [{ number: '1234567', citycode: '1', contrycode: '57' }]);"
            ]
          }
        }
