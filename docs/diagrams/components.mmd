flowchart LR
  Client([Cliente HTTP])

  subgraph infra_in [infrastructure.web]
    Web["UserController / UserApi<br/>GlobalExceptionHandler<br/>ApiErrorController"]
  end

  subgraph app [application]
    UC["RegisterUserUseCase<br/>RegisterUserCommand"]
  end

  subgraph dom [domain]
    Model["User, UserId, Email, Phone<br/>PasswordPolicy, RegexPasswordPolicy<br/>excepciones de dominio"]
    Ports["Puertos<br/>UserRepository<br/>PasswordHasher<br/>TokenIssuer"]
  end

  subgraph infra_out [adaptadores de infrastructure]
    Pers["persistence<br/>UserPersistenceAdapter"]
    Sec["security<br/>BCryptPasswordHasher<br/>JjwtTokenIssuer"]
  end

  Cfg["infrastructure.config<br/>ApplicationConfig<br/>RegistrationProperties, OpenApiConfig"]
  H2[("H2 en memoria<br/>schema.sql")]

  Client -->|"POST /api/v1/users"| Web
  Web --> UC
  UC --> Model
  UC --> Ports
  Pers -.->|implementa UserRepository| Ports
  Sec -.->|implementa PasswordHasher y TokenIssuer| Ports
  Pers --> H2
  Cfg -.->|crea el caso de uso y la política| UC
